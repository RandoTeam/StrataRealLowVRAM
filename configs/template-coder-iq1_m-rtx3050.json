{
  "comment": "Optimized configuration for Qwen 3.8 Flash Next Coder IQ1_M on RTX 3050 Laptop (4GB VRAM) + 32GB RAM (Windows 11)",
  "exe": "engine/strata.exe",
  "args": [
    "--pack", "data/packs/coder-iq1_m",
    "--native", "data/models/coder-IQ1_M/Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M-00001-of-00002.gguf",
    "--ple-gguf", "data/models/coder-IQ1_M/Qwen3.8-Flash-Next-GSQ-RCO-IQ1_M-00002-of-00002.gguf",
    "--ple-io", "direct",
    "--ple-row-cache", "2097152",
