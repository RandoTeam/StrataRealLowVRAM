# ==============================================================================
# Git Hygiene & Security Configuration - Strata Real Low-VRAM
# ==============================================================================

# 1. Credentials, API Keys, Tokens & Private Secrets
.env
.env.*
*.key
*.pem
*.token
*secret*
*credential*
api_key.txt
hf_token
*.id_rsa
*.id_ed25519

# 2. Large Model Weights & Dynamic Binary Blobs (Multi-Gigabyte)
*.gguf
*.safetensors
*.pt
*.onnx
models/
packs/
mtp/
pack/
/third_party/llama.cpp
/third_party/*.zip
data/expert-profile-learned.bin
data/downloads/

# Whitelist small static distribution tables in data/
!data/expert-profile.bin
!data/draft_vocab*.bin
!data/gguf_fingerprints.json

# 3. Crash Dumps, Profiler Traces & Diagnostics
*.dmp
*.mdmp
core
core.*
*.nsys-rep

# 4. Logs, Runtime Traces & Backups
*.log
strata-*.log
td.log
logs/
*.bak
*.orig
*.tmp
strata-*.json.bak

# 5. Local Python Virtual Environments & Bytecode Caches
.venv/
env/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.obj
*.exp
*.lib
/engine/
/engine-cuda12/
docs/superpowers/
Strata-data/
.pytest_cache/
*.egg-info/
dist/
build*/
/.ccache/
/.rocm-win/

# 6. Local Benchmark Results & Intermediate Diagnostic Scratch Files
calibration_report.json
tuning_history.json
golden_baseline_*.json
baseline_*.json
final_optimized_benchmark.json
help.txt
scratch/

# 7. IDE, Editor & OS Artifacts
.vscode/
.idea/
.cursor/
.vs/
Thumbs.db
desktop.ini
.DS_Store
*.sqlite
*.npz
*.occ1
/.strata-mcp/

# 8. User-generated Batches (whitelist release scripts)
run-*.bat
!run-q2_0.bat
!run-27b.bat
run-*.sh
strata-*.json
!strata-q2_0.json
build-strata*.bat
build-vision*.bat
build-release*/
